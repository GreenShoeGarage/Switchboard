{$SWITCHBOARD_SITE_ADDRESS:http://localhost} {
  encode zstd gzip
  reverse_proxy switchboard:3000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up -X-Switchboard-Authenticated-User-Email
    header_up -X-Switchboard-Authenticated-User-Role
    header_up -X-Switchboard-Client-Address
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
  }
}
